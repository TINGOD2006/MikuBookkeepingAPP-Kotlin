<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 必要權限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 側載版供用戶選擇所有已安裝 App，無法以固定 queries 列舉未知來源。
         若發佈至 Google Play，須另審核此權限用途；只針对此必要權限抑制提示。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 前台服務（讓通知監聽服務在 App 被滑掉後仍能存活） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 啟用 API 33+ 原生返回分派；編輯器與子對話框各自處理返回。 -->
    <application
        android:name=".MikuApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MikuBookkeeping">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MikuBookkeeping"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             通知監聽服務：自動記帳的主要來源。
             ⚠️ 這個服務是「主要的」記帳來源（取代 Flutter 版由 Dart 端寫入），
                因此使用者必須在系統設定中授予「通知使用權限」。
             ============================================================ -->
        <service
            android:name=".notification.PaymentNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true"
            android:enabled="true"
            android:foregroundServiceType="specialUse"
            android:label="@string/notification_listener_label">
            <!-- 持續接收用戶授權的交易通知並即時記帳，不是有期限的資料同步工作。 -->
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled continuous payment notification monitoring and automatic local bookkeeping" />
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ============================================================
             無障礙讀屏自動記帳
             （讀取白名單支付 App 的「已完成」付款結果畫面並自動記一筆；
               同時保留讀屏診斷紀錄供實機確認）
             ============================================================ -->
        <service
            android:name=".notification.PaymentAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:enabled="true"
            android:isAccessibilityTool="false"
            android:label="@string/accessibility_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/payment_accessibility_service_config" />
        </service>
    </application>

</manifest>
